# Force LF line endings for text files to ensure consistent dart format checks in CI
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf

# Binary files — do not touch
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.sqlite binary
*.sqlite3 binary
*.enc binary
